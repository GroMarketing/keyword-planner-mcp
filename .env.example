# Copy to .env (never commit it) or export these in your shell.
# Keyword Planner is part of the Google Ads API. You need a Google Ads account (no ad spend
# required) and a developer token with Basic or Standard access; test-account tokens return no data.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# The account the research runs under, digits only or 123-456-7890
GOOGLE_ADS_CUSTOMER_ID=
# Only when you reach that account through a manager (MCC) account:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
